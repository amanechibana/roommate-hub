NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
HOUSEHOLD_ACCESS_CODE=
HOUSEHOLD_SESSION_SECRET=
HOUSEHOLD_DATA_TOKEN=
# Web Push (VAPID) keys for the morning digest; generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID private key (server only, never exposed to the client)
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI sent to push services (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com
# Shared secret Vercel Cron sends as a Bearer token to /api/reminders
CRON_SECRET=your-cron-secret
